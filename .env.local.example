# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Uygulama URL — yerel geliştirmede localhost, üretimde gerçek domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Doğrulama sayfası base URL (APP_URL + /verify)
NEXT_PUBLIC_VERIFY_BASE_URL=http://localhost:3000/verify
